#!/bin/bash

set -e

BUILD_DIR=$1
CACHE_DIR=$2
ENV_DIR=$3
DOWNLOAD_URI=$(cat ${ENV_DIR}/MATTERMOST_DOWNLOAD_URI)


echo "-----> Build DIR: ${BUILD_DIR}"
echo "-----> Cache DIR: ${CACHE_DIR}"
echo "-----> Env DIR: ${ENV_DIR}"
echo "-----> Mattermost URI: ${MATTERMOST_DOWNLOAD_URI}"
echo "-----> Current DIR:"
pwd

echo "-----> Retrieving mattermost tar from ${DOWNLOAD_URI}"
curl -s -L "${DOWNLOAD_URI}" | tar -zxf - --strip-components=1 -C ${BUILD_DIR}


echo "-----> Removing unnecessary prepackaged plugins"
rm -f ${BUILD_DIR}/prepackaged_plugins/focalboard-*
rm -f ${BUILD_DIR}/prepackaged_plugins/mattermost-plugin-boards-*
rm -f ${BUILD_DIR}/prepackaged_plugins/mattermost-plugin-github-*
rm -f ${BUILD_DIR}/prepackaged_plugins/mattermost-plugin-gitlab-*
rm -f ${BUILD_DIR}/prepackaged_plugins/mattermost-plugin-mscalendar-*
rm -f ${BUILD_DIR}/prepackaged_plugins/mattermost-plugin-msteams-*
rm -f ${BUILD_DIR}/prepackaged_plugins/mattermost-plugin-nps-*
rm -f ${BUILD_DIR}/prepackaged_plugins/mattermost-plugin-playbooks-*
rm -f ${BUILD_DIR}/prepackaged_plugins/mattermost-plugin-servicenow-*
rm -f ${BUILD_DIR}/prepackaged_plugins/mattermost-plugin-zoom-*

mkdir -p ${BUILD_DIR}/data/
